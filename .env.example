# Copy to .env and fill in. .env is git-ignored; this file is committed and must
# only ever contain placeholders.
#
# A Slack webhook URL is a CREDENTIAL in its own right: anyone holding it can
# post to the channel. It must never reach a commit, a screenshot, a log line,
# or the deck. If one leaks, delete the hook in Slack and create a new one —
# rotating is a minute of work and there is no other remedy.

# Slack — Incoming Webhook. The channel is fixed when the hook is created.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLACEHOLDER

# Sarvam — the model layer. sarvam-105b; Sarvam-M is deprecated.
SARVAM_API_KEY=replace-me

# AWS SES, sandbox: delivers ONLY to verified addresses.
SES_FROM=replace-me@example.com
SES_TO=teammate-one@example.com,teammate-two@example.com

# AWS. Prefer `aws configure` / SSO over putting long-lived keys here at all.
AWS_REGION=ap-south-1

# Where the trip logs live. A local directory on the day, an s3:// prefix in
# production — source_for() abstracts the difference.
SIGNALDESK_DATA=../data/fixture

# Comma-separated origins allowed to call the API. Wildcards are fine on a
# laptop and wrong on a public URL.
SIGNALDESK_CORS_ORIGINS=http://localhost:5173
